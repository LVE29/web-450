.DS_Store
# Keep local database credentials out of version control.
.env
.env.*
!.env.example

# Exclude installed dependencies and generated build files.
**/node_modules/
**/dist/
**/.angular/

# Keep local database credentials out of GitHub.
**/.env
**/.env.*
!**/.env.example

# Exclude the local Git history backup, which contains old credentials.
*.bundle